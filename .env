# Local Development Environment
# Replace with your NEW Supabase project credentials

# Database - NEW Supabase Connection
DATABASE_URL="postgresql://postgres:your-password@db.your-new-project-id.supabase.co:5432/postgres"

# NextAuth.js - Local Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-new-secret-key-use-openssl-rand-base64-32"

# Supabase - NEW Project Configuration 
NEXT_PUBLIC_SUPABASE_URL="https://your-new-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-new-anon-key-from-supabase"
SUPABASE_SERVICE_ROLE_KEY="your-new-service-role-key-from-supabase"

# Development-only variables (not needed in Vercel)
NODE_ENV="development"
ANALYZE="false"