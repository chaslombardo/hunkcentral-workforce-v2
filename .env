# Local Development Environment (Preview Supabase)
# Update these with your PREVIEW Supabase project credentials

# Database - Preview Supabase Connection
DATABASE_URL="postgresql://postgres:[PREVIEW-PASSWORD]@db.[PREVIEW-PROJECT-REF].supabase.co:5432/postgres"

# NextAuth.js - Local Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-local-nextauth-secret-32-chars-min"

# Supabase - Preview Project Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[PREVIEW-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-preview-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-preview-supabase-service-role-key"# Devel
opment-only variables (not needed in Vercel)
NODE_ENV="development"
ANALYZE="false"